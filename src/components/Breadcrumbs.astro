---
export interface Crumb {
  label: string;
  /** Omit for the current page (rendered as plain text). */
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const crumbs: Crumb[] = [{ label: 'Home', href: '/' }, ...items];
---

<nav aria-label="Breadcrumb" class="mb-8 text-sm">
  <ol class="flex flex-wrap items-center gap-2 text-neutral-500 dark:text-neutral-400">
    {crumbs.map(({ label, href }, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {href && i < crumbs.length - 1 ? (
          <a
            href={href}
            class="text-neutral-900 underline underline-offset-4 transition-colors hover:text-neutral-600 dark:text-neutral-100 dark:hover:text-neutral-300"
          >
            {label}
          </a>
        ) : (
          <span aria-current="page">{label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
