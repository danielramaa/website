---
import type { IconLinkData } from '../data/links';

type Props = IconLinkData;

const { label, href, icon } = Astro.props;
const external = href.startsWith('http');
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class="inline-flex items-center gap-2 rounded-full border border-neutral-200 px-4 py-2 text-sm font-medium transition-colors hover:bg-neutral-100 dark:border-neutral-800 dark:hover:bg-neutral-900"
>
  <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true"><path d={icon} /></svg>
  {label}
</a>
