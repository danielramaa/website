---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside class="not-prose my-6 rounded-lg border-l-4 border-sky-500 bg-sky-50 px-4 py-3 dark:bg-sky-950/40">
  {title && <p class="font-semibold text-sky-900 dark:text-sky-200">{title}</p>}
  <div class="text-sky-800 dark:text-sky-300">
    <slot />
  </div>
</aside>
