---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Intro from '../content/intro.mdx';
import profile from '../assets/profile.webp';
import IconLink from '../components/IconLink.astro';
import { AFFILIATIONS, CONTACT_LINKS, SOCIAL_LINKS } from '../data/links';
---

<Layout>
  <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
    <div class="flex shrink-0 flex-col items-center gap-3 self-start sm:self-auto">
      <Image
        src={profile}
        alt="Photo of Daniel Rama"
        width={256}
        height={256}
        loading="eager"
        class="size-32 rounded-full object-cover ring-1 ring-neutral-200 dark:ring-neutral-800"
      />
      <ul class="flex gap-2">
        {AFFILIATIONS.map(({ label, href, logo, bg }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              title={label}
              aria-label={label}
              class={`flex size-9 items-center justify-center overflow-hidden rounded-full ring-1 ring-neutral-200 transition-transform hover:scale-110 dark:ring-neutral-800 ${bg}`}
            >
              <img src={logo} alt="" class="size-6 object-contain" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h1 class="text-4xl font-bold tracking-tight">Hi, I'm Daniel.</h1>
      <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
        Informatics and Computing Engineering student at FEUP, Porto.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href="/cv/"
          class="inline-flex items-center gap-2 rounded-full border border-transparent bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
        >
          View CV
        </a>
        <a
          href="/projects/"
          class="inline-flex items-center gap-2 rounded-full border border-neutral-200 px-4 py-2 text-sm font-medium transition-colors hover:bg-neutral-100 dark:border-neutral-800 dark:hover:bg-neutral-900"
        >
          Projects
        </a>
      </div>
    </div>
  </div>

  <section class="mt-12" aria-labelledby="socials">
    <h2 id="socials" class="text-2xl font-bold tracking-tight">Socials</h2>
    <ul class="mt-4 flex flex-wrap gap-3">
      {SOCIAL_LINKS.map((link) => <li><IconLink {...link} /></li>)}
    </ul>
  </section>

  <section class="prose prose-neutral dark:prose-invert mt-12">
    <Intro />
  </section>

  <section class="mt-12" aria-labelledby="contact">
    <h2 id="contact" class="text-2xl font-bold tracking-tight">Contact me</h2>
    <ul class="mt-4 flex flex-wrap gap-3">
      {CONTACT_LINKS.map((link) => <li><IconLink {...link} /></li>)}
    </ul>
  </section>
</Layout>
