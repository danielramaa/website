---
import Layout from '../layouts/Layout.astro';
import { CV_URL } from '../data/links';
---

<Layout title="CV — Daniel Rama" description="Curriculum vitae of Daniel Rama." wide>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-4xl font-bold tracking-tight">My CV</h1>
    <div class="flex gap-3">
      <a
        href={CV_URL}
        target="_blank"
        rel="noopener"
        class="rounded-full border border-neutral-200 px-4 py-2 text-sm font-medium transition-colors hover:bg-neutral-100 dark:border-neutral-800 dark:hover:bg-neutral-900"
      >
        Open in new tab
      </a>
      <a
        href={CV_URL}
        download="Daniel Rama - CV.pdf"
        class="rounded-full border border-transparent bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
      >
        Download PDF
      </a>
    </div>
  </div>

  <object
    data={CV_URL}
    type="application/pdf"
    class="mt-8 h-[85vh] w-full rounded-lg border border-neutral-200 dark:border-neutral-800"
  >
    <p class="p-6 text-neutral-600 dark:text-neutral-400">
      Your browser can't display the PDF here.
      <a href={CV_URL} download="Daniel Rama - CV.pdf" class="underline underline-offset-4">Download it instead.</a>
    </p>
  </object>
</Layout>
