---
import '../styles/global.css';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { NAVBAR_LINKS } from '../data/links';

interface Props {
  title?: string;
  description?: string;
  /** Use a wider content column (e.g. for the embedded CV). */
  wide?: boolean;
  /**
   * Breadcrumb trail after "Home". Generated automatically from the URL on every
   * page except the home page; pass this only to override the labels.
   */
  breadcrumbs?: Crumb[];
}

const {
  title = 'danielramaa',
  description = 'Personal website of Daniel Rama, Informatics and Computing Engineering student at FEUP.',
  wide = false,
  breadcrumbs,
} = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/#about', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/cv/', label: 'CV' },
  { href: '/#contact', label: 'Contact' },
];
const current = Astro.url.pathname;

// Labels that title-casing the URL segment would get wrong
const CRUMB_LABELS: Record<string, string> = { cv: 'CV', 404: 'Page not found' };
const segments = current.split('/').filter(Boolean);
const trail: Crumb[] =
  breadcrumbs ??
  segments.map((segment, i) => ({
    label:
      CRUMB_LABELS[segment] ??
      segment.replace(/-/g, ' ').replace(/^\w/, (c) => c.toUpperCase()),
    href: `/${segments.slice(0, i + 1).join('/')}/`,
  }));
const width = wide ? 'max-w-4xl' : 'max-w-2xl';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
    <header class="border-b border-neutral-200 bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-900">
      <nav class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-10 gap-y-3 px-6 py-5">
        <a href="/" class="text-xl font-semibold tracking-tight">danielramaa</a>

        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {nav.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={current === href ? 'page' : undefined}
                class="text-neutral-600 transition-colors hover:text-neutral-900 aria-[current=page]:font-medium aria-[current=page]:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 dark:aria-[current=page]:text-neutral-100"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>

        <ul class="flex items-center gap-5 text-sm md:ml-auto">
          {NAVBAR_LINKS.map(({ label, href, icon }) => {
            const external = href.startsWith('http');
            const isEmail = href.startsWith('mailto:');
            return (
              <li>
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  aria-label={label}
                  class="group flex items-center gap-2 text-neutral-600 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
                >
                  <span
                    class:list={[
                      'flex items-center justify-center',
                      isEmail &&
                        'size-8 rounded-full bg-neutral-200 transition-colors group-hover:bg-neutral-300 dark:bg-neutral-800 dark:group-hover:bg-neutral-700',
                    ]}
                  >
                    <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true"><path d={icon} /></svg>
                  </span>
                  <span class="hidden sm:inline">{label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </header>
    <main class={`mx-auto ${width} px-6 py-16`}>
      {trail.length > 0 && <Breadcrumbs items={trail} />}
      <slot />
    </main>
  </body>
</html>
