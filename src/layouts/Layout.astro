---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Use a wider content column (e.g. for the embedded CV). */
  wide?: boolean;
}

const {
  title = 'Daniel Rama',
  description = 'Personal website of Daniel Rama, Informatics and Computing Engineering student at FEUP.',
  wide = false,
} = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/cv/', label: 'CV' },
];
const current = Astro.url.pathname;
const width = wide ? 'max-w-4xl' : 'max-w-2xl';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
    <header class={`mx-auto ${width} px-6 pt-8`}>
      <nav class="flex items-center justify-between">
        <a href="/" class="font-semibold tracking-tight">Daniel Rama</a>
        <ul class="flex gap-6 text-sm">
          {nav.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={current === href ? 'page' : undefined}
                class="text-neutral-500 transition-colors hover:text-neutral-900 aria-[current=page]:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 dark:aria-[current=page]:text-neutral-100"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main class={`mx-auto ${width} px-6 py-16`}>
      <slot />
    </main>
  </body>
</html>
